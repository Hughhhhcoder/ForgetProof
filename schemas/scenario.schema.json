{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoryproof.dev/schema/scenario/v1.json",
  "title": "MemoryProof Assurance Scenario",
  "description": "A deterministic scenario for erasure or tenant-isolation assurance checks.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "memoryproof.dev/v1" },
    "kind": { "const": "AssuranceScenario" },
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["suite", "adapter", "fixtures", "settle", "probes", "profiles"],
      "properties": {
        "suite": { "enum": ["erasure", "isolation"] },
        "adapter": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "mode": { "type": "string" },
            "config": { "type": "object", "additionalProperties": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "isolation": {
          "type": "object",
          "properties": {
            "scope": { "type": "string", "minLength": 1 },
            "target_subject": { "type": "string", "minLength": 1 },
            "control_subject": { "type": "string", "minLength": 1 },
            "subject": { "type": "string" },
            "agent": { "type": "string" },
            "thread": { "type": "string" }
          },
          "additionalProperties": false
        },
        "fixtures": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "role", "content"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "role": { "enum": ["target", "control"] },
              "content": { "type": "string", "minLength": 1 },
              "subject": { "type": "string", "minLength": 1 },
              "namespace": { "type": "string" },
              "kind": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "settle": {
          "type": "object",
          "properties": {
            "timeout_ms": { "type": "integer", "minimum": 1 },
            "interval_ms": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "erase": {
          "type": "object",
          "properties": {
            "intent": { "enum": ["object_delete", "subject_erase", "access_revoke", "derived_purge"] },
            "target": { "type": "string", "minLength": 1 },
            "scope": { "type": "string" }
          },
          "additionalProperties": false
        },
        "probes": {
          "type": "object",
          "required": ["before", "after"],
          "properties": {
            "before": { "$ref": "#/$defs/probeList" },
            "after": { "$ref": "#/$defs/probeList" }
          },
          "additionalProperties": false
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "erasure.object",
              "erasure.scope",
              "erasure.derived",
              "erasure.agent",
              "isolation.read",
              "isolation.search",
              "isolation.agent"
            ]
          }
        },
        "privacy": {
          "type": "object",
          "properties": {
            "raw_payloads": { "type": "boolean", "default": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "suite": { "const": "erasure" } } },
          "then": { "required": ["erase"] }
        }
      ]
    }
  },
  "$defs": {
    "probeList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fixture"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "fixture": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["exact", "lexical", "semantic", "inspect", "agent"] },
          "query": { "type": "string" },
          "as_subject": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
